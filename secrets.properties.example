# Copy this file to secrets.properties (git-ignored, never commit real values) and fill in
# the credentials from your TikTok for Developers app (https://developers.tiktok.com/apps).
# See BUILD.md for step-by-step registration instructions.

TIKTOK_CLIENT_KEY=CHANGE_ME
TIKTOK_CLIENT_SECRET=CHANGE_ME
# Must be an https:// URL registered exactly as-is in your app's Login Kit redirect URI list.
# A free static page (e.g. GitHub Pages) is enough — TokVision intercepts this URL inside its
# own WebView before it ever finishes loading, so the page's content doesn't matter.
TIKTOK_REDIRECT_URI=https://vampirekun.github.io/TokVision/callback/
